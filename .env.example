# ==============================================================================
# متغيرات البيئة لتطبيق "أبوي وأمي" (My Parents Call) - Production Environment
# ==============================================================================

# منفذ التشغيل والبيئة
PORT=3000
NODE_ENV=production

# النطاقات المسموحة للاتصال عبر CORS و WebSocket (يمكن كتابة أكثر من نطاق مفصولاً بفاصلة)
ALLOWED_ORIGIN=https://my-parents-call.local,http://localhost:3000

# المفتاح السري لتوقيع رموز JWT (يجب أن يكون سلسلة عشوائية قوية جداً 256-bit)
JWT_SECRET=your_super_secret_jwt_random_key_here_min_32_characters

# مدة صلاحية رمز المصادقة (Tokens قصيرة الأجل لتقليل نافذة هجمات الاستيلاء على الجلسة)
JWT_EXPIRES_IN=15m

# التشفير المالح (Bcrypt Hash) لرمز الدخول السري العائلي (PIN)
# مثال للرمز الافتراضي (2026): يمكنك توليد رمزك عبر: node -e "console.log(require('bcryptjs').hashSync('YOUR_PIN', 10))"
FAMILY_PIN_HASH=$2b$10$PYqtJ4Zmnqi62caaB2gqxOXG.XeJNagaT.kZkLhhmG5E2zBHPVbEW

# إعدادات سيرفرات STUN و TURN (CoTURN)
# خادم STUN لاكتشاف العناوين العامة المباشرة
STUN_SERVER_URL=stun:stun.l.google.com:19302

# خادم TURN للترحيل في حال وجود جدران حماية معقدة Symmetric NAT
TURN_SERVER_URL=turn:turn.yourdomain.com:3478
TURN_SERVER_TLS_URL=turns:turn.yourdomain.com:5349

# المفتاح السري المشترك لسيرفر CoTURN لتوليد بيانات الاعتماد المؤقتة (Ephemeral Credentials)
# يجب أن يتطابق تماماً مع static-auth-secret في ملف turnserver.conf
TURN_STATIC_AUTH_SECRET=ddcf348d65b1ed58c81af8568faa4ad2c72df2b3d5fec285b399198173708e78

# مهلة صلاحية بيانات اعتماد TURN المؤقتة بالثواني (1800 ثانية = 30 دقيقة)
TURN_CREDENTIALS_TTL_SECONDS=1800

# أمان طلبات HTTP (Rate Limiting)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
